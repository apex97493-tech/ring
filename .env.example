# ==============================================================================
# FOREVER JEWELL STUDIO — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and fill in your client / store credentials
# NEVER COMMIT .env.local TO GIT (Protected by .gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONNECTION (SUPABASE / POSTGRESQL ON HOSTINGER VPS)
# ------------------------------------------------------------------------------
# For Hostinger VPS with native PostgreSQL:
# DATABASE_URL="postgresql://fj_user:YOUR_STRONG_PASSWORD@localhost:5432/fj_database?sslmode=disable"
# DIRECT_URL="postgresql://fj_user:YOUR_STRONG_PASSWORD@localhost:5432/fj_database?sslmode=disable"
#
# For Supabase Cloud:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require"
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"
NEXT_PUBLIC_SUPABASE_STORAGE_URL="https://[YOUR-PROJECT-REF].supabase.co/storage/v1/object/public/product-images"

# ------------------------------------------------------------------------------
# 2. PAYPAL PORTAL CREDENTIALS
# ------------------------------------------------------------------------------
# Get your Client ID and Secret from https://developer.paypal.com/dashboard/
NEXT_PUBLIC_PAYPAL_CLIENT_ID="[YOUR-PAYPAL-CLIENT-ID]"
PAYPAL_CLIENT_SECRET="[YOUR-PAYPAL-CLIENT-SECRET]"
# Set to "production" (or "live") for real payments, or "sandbox" for testing
PAYPAL_ENV="sandbox"

# ------------------------------------------------------------------------------
# 3. DIRECT BANK TRANSFER & UPI (OFFICIAL STORE ACCOUNT)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BANK_NAME="Kotak Mahindra Bank"
NEXT_PUBLIC_BANK_ACCOUNT="[YOUR-STORE-ACCOUNT-NUMBER]"
NEXT_PUBLIC_BANK_IFSC="[YOUR-BANK-IFSC-CODE]"
NEXT_PUBLIC_BANK_BRANCH="Jaipur - Vaishali Nagar"
NEXT_PUBLIC_BANK_CRN="[YOUR-CRN-OR-CUSTOMER-ID]"
NEXT_PUBLIC_UPI_ID="[YOUR-STORE-UPI-ID@bank]"

# ------------------------------------------------------------------------------
# 4. PAYONEER INTERNATIONAL TRANSFERS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PAYONEER_EMAIL="billing@foreverjewellstudio.com"

# ------------------------------------------------------------------------------
# 5. OFFICIAL STORE WHATSAPP & SUPPORT PHONE
# ------------------------------------------------------------------------------
# Country code without '+' or spaces (e.g. 919828930454)
NEXT_PUBLIC_WHATSAPP_NUMBER="919828930454"
NEXT_PUBLIC_STORE_PHONE="+91 98289 30454"

# ------------------------------------------------------------------------------
# 6. STORE DOMAIN & URL
# ------------------------------------------------------------------------------
# Local: http://localhost:3000 | Production: https://yourdomain.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 7. ADMIN DASHBOARD SECURITY (/burger)
# ------------------------------------------------------------------------------
# Master password used to access the admin portal before 2FA OTP
ADMIN_MASTER_PASSWORD="YourStrongAdminPassword2026!"
# Backup legacy tokens (comma-separated)
ADMIN_TOKENS="forever2026,aura2026,admin"

# ------------------------------------------------------------------------------
# 8. AUTOMATIC EMAIL NOTIFICATIONS & 2FA PASSCODES (RESEND.COM)
# ------------------------------------------------------------------------------
# Store owner email that receives all order alerts and 2FA login passcodes
ADMIN_NOTIFICATION_EMAIL="Foreverjewels98@gmail.com"
STORE_OWNER_EMAIL="Foreverjewels98@gmail.com"
STORE_OWNER_NAME="Forever Jewell Store Owner"

# Free Resend API Key from https://resend.com/api-keys
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
# Once your custom domain is verified on Resend, change to: orders@yourdomain.com
SENDER_EMAIL="onboarding@resend.dev"
